# Configure these in the hosting environment, or in OFFSHORE_CONFIG outside the vault.
DATABASE_URL=postgresql://offshore:CHANGE_ME@127.0.0.1:5432/offshore
# Optional pooled URL, used by the application when supplied by Prisma Postgres.
DATABASE_URL_POOLED=
# Optional direct PostgreSQL connection for migrations when DATABASE_URL uses a pooler.
DIRECT_DATABASE_URL=
# Generate with npm run setup; never use a plain-text password here.
PROJECT_PASSWORD_HASH=
# Generate a random value with at least 32 characters. Rotation revokes existing sessions.
SESSION_SECRET=
APP_URL=http://localhost:3000
SESSION_HOURS=12
