{
  "name": "offshore-journey",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "prisma generate && next build --webpack",
    "vercel-build": "prisma generate && prisma migrate deploy && next build --webpack",
    "start": "node scripts/run.mjs start",
    "setup": "node scripts/setup.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/run.mjs migrate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/application.spec.cjs",
    "test:structure": "node tests/structure.spec.cjs",
    "test:study": "node tests/study.spec.cjs",
    "package": "node scripts/package.mjs",
    "postinstall": "prisma generate",
    "format": "prettier --write 'src/{app,components,lib,server}/**/*.{ts,tsx,css}' 'scripts/*.mjs' 'tests/{application,fidelity}.spec.cjs' next.config.ts prisma.config.ts vitest.config.ts",
    "test:fidelity": "node tests/fidelity.spec.cjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/functions": "3.6.1",
    "argon2": "^0.44.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "18.4.0-beta.17",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
